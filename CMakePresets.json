{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "mingw",
      "displayName": "MinGW GCC (Release)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/mingw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "msvc",
      "displayName": "Visual Studio 2022 (x64)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc"
    },
    {
      "name": "headless",
      "displayName": "Headless only (no SDL3 download)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SCRAPS_WITH_SDL3": "OFF" }
    },
    {
      "name": "release-mingw",
      "displayName": "Release package, MinGW GCC (game linked statically, no hot reload)",
      "inherits": "mingw",
      "binaryDir": "${sourceDir}/build/release-mingw",
      "cacheVariables": { "SCRAPS_HOT_RELOAD": "OFF" }
    },
    {
      "name": "release-msvc",
      "displayName": "Release package, Visual Studio 2022 (game linked statically, no hot reload)",
      "inherits": "msvc",
      "binaryDir": "${sourceDir}/build/release-msvc",
      "cacheVariables": { "SCRAPS_HOT_RELOAD": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "mingw", "configurePreset": "mingw", "jobs": 8 },
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "headless", "configurePreset": "headless", "jobs": 8 },
    {
      "name": "mingw-game",
      "displayName": "MinGW: only the game module (hot reload while the apps run)",
      "configurePreset": "mingw",
      "jobs": 8,
      "targets": ["scraps_game_module"]
    },
    {
      "name": "msvc-game",
      "displayName": "MSVC: only the game module (hot reload while the apps run)",
      "configurePreset": "msvc",
      "configuration": "Release",
      "targets": ["scraps_game_module"]
    },
    { "name": "release-mingw", "configurePreset": "release-mingw", "jobs": 8 },
    { "name": "release-msvc", "configurePreset": "release-msvc", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "mingw", "configurePreset": "mingw", "output": { "outputOnFailure": true } },
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } },
    { "name": "release-mingw", "configurePreset": "release-mingw", "output": { "outputOnFailure": true } },
    {
      "name": "release-msvc",
      "configurePreset": "release-msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ],
  "packagePresets": [
    { "name": "release-mingw", "configurePreset": "release-mingw", "generators": ["ZIP"] },
    { "name": "release-msvc", "configurePreset": "release-msvc", "generators": ["ZIP"], "configurations": ["Release"] }
  ],
  "workflowPresets": [
    {
      "name": "release-mingw",
      "displayName": "Configure, build, test and zip a release with MinGW GCC",
      "steps": [
        { "type": "configure", "name": "release-mingw" },
        { "type": "build", "name": "release-mingw" },
        { "type": "test", "name": "release-mingw" },
        { "type": "package", "name": "release-mingw" }
      ]
    },
    {
      "name": "release-msvc",
      "displayName": "Configure, build, test and zip a release with Visual Studio 2022",
      "steps": [
        { "type": "configure", "name": "release-msvc" },
        { "type": "build", "name": "release-msvc" },
        { "type": "test", "name": "release-msvc" },
        { "type": "package", "name": "release-msvc" }
      ]
    }
  ]
}
