scraps-scene 1
# A small isometric courtyard with steps. WASD moves along the screen
# directions, Space jumps (one block high). Press V to see the same scene
# top-down or from the side.

view isometric
size 12 12 4

# Background: one colour, or top then bottom for a blend.
sky 44 52 98 232 156 120

# Sound effects (made by tools/make_sandbox_sounds.py). Any common format works;
# these three are WAV, OGG and MP3 on purpose. The game plays them by name.
sound jump sounds/jump.wav
sound coin sounds/coin.ogg
sound drop sounds/drop.mp3 volume 0.8

image grass  art/grass.png  frames 3
image wall   art/wall.png   frames 2
image stone  art/stone.png  frames 2
image leaves art/leaves.png frames 2
image hero   art/hero.png   frames 4 fps 8
image coin   art/coin.png   frames 4 fps 8

tile g grass solid 96  164 80  texture grass
tile # wall  solid 150 140 160 texture wall
tile s stone solid 170 170 180 texture stone
tile b bush  solid 50  120 70  texture leaves

archetype hero kind 1 size 0.6 0.6 0.9 color 235 90 70 speed 4.5 flags moves,gravity,collides sprite hero
archetype coin kind 2 size 0.3 0.3 0.3 color 250 210 60 sprite coin

player hero
spawn 6.5 6.5 1
spawn 7.5 5.5 1
spawn 5.5 7.5 1

entity coin 4.5 4.5 2.1
entity coin 4.5 3.5 3.1
entity coin 9.5 9.5 1.1
entity coin 2.5 9.5 1.1
entity coin 7.5 7.5 2.1

fill 0 g
