scraps-scene 1
# A walled garden seen from above. Walk with WASD or the arrow keys,
# pick up the yellow coins, press E to drop one. Format: docs/scene-format.md

view top-down
size 24 14 2

# Background: one colour, or top then bottom for a blend.
sky 30 40 34

# Sound effects (made by tools/make_sandbox_sounds.py). Any common format works;
# these three are WAV, OGG and MP3 on purpose. The game plays them by name.
sound jump sounds/jump.wav
sound coin sounds/coin.ogg
sound drop sounds/drop.mp3 volume 0.8

# Art (generated by tools/make_sandbox_art.py). Paths are relative to this file.
image grass   art/grass.png   frames 3
image wall    art/wall.png    frames 2
image leaves  art/leaves.png  frames 2
image water   art/water.png
image hero    art/hero.png    frames 4 fps 8
image coin    art/coin.png    frames 4 fps 8
image critter art/critter.png frames 2 fps 4

#    symbol name   kind  r   g   b   (colour is the fallback without a texture)
tile g      grass  solid 92  156 76  texture grass
tile #      wall   solid 120 112 128 texture wall
tile T      tree   solid 46  110 60  texture leaves
tile w      water  solid 64  120 200 texture water

# Kinds are defined by the game (games/sandbox/sandbox.h): 1 player, 2 coin, 3 wanderer.
archetype hero    kind 1 size 0.7 0.7 0.9  color 235 90 70   speed 5 flags moves,collides sprite hero
archetype coin    kind 2 size 0.35 0.35 0.35 color 250 210 60 sprite coin
archetype critter kind 3 size 0.4 0.4 0.4  color 180 140 230 speed 2 flags moves,collides,bounces sprite critter

player hero
spawn 3.5 2.5 1
spawn 5.5 2.5 1
spawn 3.5 4.5 1
spawn 5.5 4.5 1

entity coin 12.5 3.5 1.2
entity coin 20.5 2.5 1.2
entity coin 13.5 8.5 1.2
entity coin 4.5 9.5 1.2
entity coin 20.5 11.5 1.2
entity coin 8.5 12.5 1.2

crowd critter 8

# Layer 0 is the ground; layer 1 holds walls, trees and water.
fill 0 g
layer 1
