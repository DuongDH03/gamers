# The game-module boundary hash (spec 2026-11-12-mouse-and-hot-reload.md,
# part B, "Review fixes").
#
# A game module (scraps_sandbox_module) is compiled against the engine's
# headers and its own copy of the engine code it calls, then loaded into an
# exe that was built earlier. Sizes and offsets alone (core/game_api.h) miss
# two swapped float fields, a changed enum value, a new constant or a changed
# job-system protocol. So the build also hashes the *contents* of every
# source that defines what crosses the boundary, and both sides mix that hash
# into kGameLayoutHash. A module built after any of them changed is refused
# by an exe built before.
#
#   scraps_boundary_files(<out> <root>)      the files, sorted, absolute
#   scraps_boundary_hash(<out> <root> <files...>)  16 hex digits
#
# Which files: every header in engine/core and engine/platform (the types,
# enums and constants both sides compile against), plus the two .cpp files
# whose code both sides run on the same objects:
#   - core/jobs.cpp: the exe owns the JobSystem and its worker threads run
#     the exe's copy; the module's copy of parallel_for writes the members
#     those workers read. Both copies must speak the same protocol.
#   - core/world.cpp: spawn_entity, destroy_entity and find_entity keep the
#     handle and free-list rules of the World, which the exe and the module
#     both read and write through their own copies.
# Every other engine .cpp is code the module simply carries its own copy of;
# a change there is what hot reload is for.
#
# The hash is over raw bytes, so a comment-only edit or a change of line
# endings also changes it. That errs on the safe side: the old exe refuses
# the module, and a restart fixes it.

set(SCRAPS_BOUNDARY_GLOBS
  engine/core/*.h
  engine/platform/*.h
  engine/core/jobs.cpp
  engine/core/world.cpp)

function(scraps_boundary_files out root)
  set(patterns "")
  foreach(glob IN LISTS SCRAPS_BOUNDARY_GLOBS)
    list(APPEND patterns "${root}/${glob}")
  endforeach()
  if(CMAKE_SCRIPT_MODE_FILE)
    file(GLOB files LIST_DIRECTORIES false ${patterns})
  else()
    # CONFIGURE_DEPENDS: a header added to or removed from these folders
    # re-runs configure on the next build.
    file(GLOB files LIST_DIRECTORIES false CONFIGURE_DEPENDS ${patterns})
  endif()
  list(REMOVE_DUPLICATES files)
  list(SORT files)
  set(${out} "${files}" PARENT_SCOPE)
endfunction()

function(scraps_boundary_hash out root)
  set(text "")
  foreach(file IN LISTS ARGN)
    file(RELATIVE_PATH relative "${root}" "${file}")
    file(SHA256 "${file}" digest)
    # The path relative to the source root, not the absolute one: two
    # build trees of the same sources get the same hash.
    string(APPEND text "${relative}:${digest}\n")
  endforeach()
  string(SHA256 total "${text}")
  string(SUBSTRING "${total}" 0 16 short)
  set(${out} "${short}" PARENT_SCOPE)
endfunction()

# The header both sides include (core/game_api.h). `hash` is 16 hex digits.
function(scraps_boundary_header_text out hash count)
  set(${out} "#pragma once

// Generated by CMake (cmake/ScrapsBoundaryHash.cmake). Do not edit.
// A hash of the contents of the ${count} engine sources that define the
// game-module boundary; core/game_api.h mixes it into kGameLayoutHash.

#include <cstdint>

namespace scraps {

constexpr std::uint64_t kBoundarySourcesHash = 0x${hash}ull;

}  // namespace scraps
" PARENT_SCOPE)
endfunction()
