#pragma once

// Generated by scraps_add_game() (cmake/ScrapsGame.cmake) for the game
// '@SCRAPS_GAME_NAME@'. Do not edit: the template is cmake/selected_game.h.in.
//
// The game an app is built for (CMake option SCRAPS_GAME). Apps include this
// instead of naming a game, so the same apps/*/main.cpp run any game under
// games/ (spec docs/specs/2026-11-14-offline-essentials-and-ui.md, part 5).

#include "core/game_api.h"

namespace scraps_apps {

struct SelectedGame {
  const char* name;              // the game's CMake name ("@SCRAPS_GAME_NAME@")
  const char* default_scene;     // played without --scene ("@SCRAPS_GAME_DEFAULT_SCENE@")
  const char* source_scene_dir;  // its scenes folder in the source tree (the development fallback)
  bool hot_reload;               // false in release builds: no module, --hot-game is not available
  // Only meaningful with hot_reload:
  const char* module_file;    // the hot-reload module the build writes (UTF-8)
  const char* build_command;  // how to rebuild only that module, for the console and HUD hints
  const char* other_builds;   // other configurations' module files, '|'-separated (MSVC)
};

const SelectedGame& selected_game();

// The game's description, linked into this program (the static build).
const scraps::GameApi* selected_game_api();

}  // namespace scraps_apps
